# ── Local-first Data Analysis Agent — environment ────────────────────────────
# Copy to `.env` and fill in your Anthropic key. `.env` is git-ignored.

AGENT_DATABASE_URL=sqlite:///./data/agent.db

# LLM provider — auto-detected from whichever key is set below.
# Override explicitly: anthropic | gemini
# AGENT_LLM_PROVIDER=anthropic

# Override model (uses provider default claude-sonnet-4-6 when blank):
# AGENT_LLM_MODEL=claude-sonnet-4-6

# Set the Anthropic provider key (required — this is the one manual setup step):
AGENT_ANTHROPIC_API_KEY=
AGENT_GEMINI_API_KEY=

# ── Privacy invariant & execution bounds (defaults shown) ────────────────────
# Only schema (columns+dtypes) + this many sample rows ever reach the LLM.
AGENT_SAMPLE_ROWS=5
# Per-cell string cap (chars) applied to every sampled/result cell before it can leave.
AGENT_SAMPLE_CELL_CHARS=200
# Max rows kept in a bounded result summary sent to the answer node.
AGENT_RESULT_ROWS=20
# Wall-clock timeout (seconds) for locally-executed generated code.
AGENT_EXEC_TIMEOUT=30
# Max refine loops on execution error / failed verification before best-guess-with-flag.
AGENT_MAX_RETRIES=3
# Reject uploads larger than this many megabytes.
AGENT_MAX_UPLOAD_MB=500

# ── Phase 3 — sources, memory, DB pushdown (defaults shown) ──────────────────
# How many prior conversation turns (question+answer) are fed back per session.
AGENT_MEMORY_TURNS=8
# Safety cap wrapped around any generated read-only SQL (defense-in-depth).
AGENT_SQL_MAX_ROWS=100000
# Optional — install the `db` extra for Postgres/MySQL connections:
#   uv sync --extra db
# (SQLite connections need no extra driver.)

# ── Observability (optional) ─────────────────────────────────────────────────
# Enable LangSmith tracing by setting these; otherwise tracing is a no-op.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=data-analysis-agent

PORT=8001
